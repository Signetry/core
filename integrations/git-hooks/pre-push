#!/usr/bin/env bash
#
# Signetry pre-push hook — govern a coding agent's change before it leaves your machine.
#
# Install:
#   cp integrations/git-hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
# or point core.hooksPath at this directory:
#   git config core.hooksPath integrations/git-hooks
#
# It runs `signetry admit` on the current checkout and BLOCKS the push unless the
# change earns branch-PR authority (L2). Set SIGNETRY_MISSION to describe the task,
# and enable an agent (SIGNETRY_ENABLE_CLAUDE_CODE=true or SIGNETRY_ENABLE_CODEX_CLI=true).
#
# Skip once with:  SIGNETRY_SKIP=1 git push
set -euo pipefail

if [[ "${SIGNETRY_SKIP:-0}" == "1" ]]; then
  echo "signetry: skipped (SIGNETRY_SKIP=1)"
  exit 0
fi

if ! command -v signetry >/dev/null 2>&1; then
  echo "signetry: CLI not found — install from source with 'pip install \"signetry-core @ git+https://github.com/Signetry/core@v0.5.4\"'." >&2
  echo "signetry: skipping the governance gate (not installed)." >&2
  exit 0
fi

MISSION="${SIGNETRY_MISSION:-Review the pending change for scope, secrets, and injected repository instructions.}"
AGENT_FLAG=""
if [[ -n "${SIGNETRY_AGENT:-}" ]]; then
  AGENT_FLAG="--agent ${SIGNETRY_AGENT}"
fi

echo "signetry: running admission on $(pwd) ..."
if signetry admit . --mission "$MISSION" $AGENT_FLAG --min-authority "${SIGNETRY_MIN_AUTHORITY:-2}"; then
  echo "signetry: change earned branch-PR authority — push allowed."
  exit 0
else
  echo "signetry: change did NOT earn branch-PR authority — push BLOCKED." >&2
  echo "signetry: re-run 'signetry admit . --mission \"...\"' to see the verdict, or override with SIGNETRY_SKIP=1." >&2
  exit 1
fi
